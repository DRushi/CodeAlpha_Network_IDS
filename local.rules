# Snort 3 local rules for a defensive IDS lab
# Use SIDs >= 1000000 for local rules.

# 1. ICMP echo request
alert icmp any any -> any any (
    msg:"LOCAL-NET ICMP Echo Request Detected";
    itype:8;
    classtype:icmp-event;
    priority:2;
    sid:1000001;
    rev:1;
)

# 2. TCP SYN to SSH
alert tcp any any -> any 22 (
    msg:"LOCAL-NET SSH Connection Attempt";
    flags:S;
    classtype:attempted-recon;
    priority:2;
    sid:1000002;
    rev:1;
)

# 3. TCP SYN to SMB
alert tcp any any -> any 445 (
    msg:"LOCAL-NET SMB Connection Attempt";
    flags:S;
    classtype:attempted-recon;
    priority:2;
    sid:1000003;
    rev:1;
)

# 4. HTTP SQL injection keyword
alert tcp any any -> any 80 (
    msg:"LOCAL-WEB Possible SQL Injection Keyword";
    flow:to_server,established;
    content:"UNION SELECT";
    nocase;
    classtype:web-application-attack;
    priority:1;
    sid:1000004;
    rev:1;
)

# 5. HTTP path traversal pattern
alert tcp any any -> any 80 (
    msg:"LOCAL-WEB Possible Path Traversal";
    flow:to_server,established;
    content:"../";
    classtype:web-application-attack;
    priority:1;
    sid:1000005;
    rev:1;
)

# 6. Suspicious command string in HTTP traffic
alert tcp any any -> any 80 (
    msg:"LOCAL-WEB Suspicious Command Execution String";
    flow:to_server,established;
    content:"/bin/sh";
    nocase;
    classtype:attempted-admin;
    priority:1;
    sid:1000006;
    rev:1;
)
